---
import SpaceshipWidget from "../components/SpaceshipWidget";
import FadeKit from "./FadeKit.astro";
---

<!-- id="games": antes decía "projects", igual que la sección Projects (id duplicado) -->
<div class="relative isolate overflow-hidden bg-gray-900 py-24 sm:py-32" id="games">
  <FadeKit />
  <!-- Fondo decorativo (aquí iba un <svg>; el </svg> suelto del original sobraba) -->
  <div class="absolute inset-0 -z-10 overflow-hidden"></div>

  <div class="mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 lg:mx-0 lg:max-w-none lg:grid-cols-2 lg:items-start lg:gap-y-10">
    <!-- Fila 1 -->
    <div class="lg:col-span-2 lg:col-start-1 lg:row-start-1 lg:mx-auto lg:grid lg:w-full lg:max-w-7xl lg:grid-cols-2 lg:gap-x-8 lg:px-8">
      <div class="fade-blob hidden sm:absolute sm:-top-10 sm:right-1/2 sm:-z-10 sm:mr-10 sm:block sm:transform-gpu sm:blur-3xl" aria-hidden="true">
        <div class="aspect-[1097/845] w-[68.5625rem] bg-gradient-to-tr from-[#1D1726] to-[#B4A6C9] opacity-70" style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:mx-0">
          <!-- data-fade + --i: mismo fade en todas las pantallas. El h1 va en un div para no pisar su hover:scale-125 -->
          <div data-fade style="--i: 0">
            <h1 class="mt-2 mb-8 text-4xl font-bold tracking-tight text-center text-gray-100 sm:text-5xl ease-in duration-300 hover:scale-125">Games </h1>
          </div>
          <p data-fade style="--i: 1" class="mt-6 text-2xl leading-8 text-gray-200">Using Three.js, React Three Fiber, WebGL, and Blender, I bring 3D models to life with smooth animations, physics, and real-time rendering. For sound design, I incorporate Howler.js, and for seamless UI interaction, I use React, for frontend rendering.</p>
          <p data-fade style="--i: 1" class="mt-6 text-2xl leading-8 text-gray-200">I hope you find it nice to look at and thank you for your visit.</p>
        </div>
      </div>

      <div data-fade style="--i: 2">
        <SpaceshipWidget client:only="react" size={400} />
      </div>
    </div>

  </div>
</div>
